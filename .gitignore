# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python environments and packaging outputs
.venv/
.venv*/
venv/
env/
ENV/
.conda/
build/
dist/
*.egg-info/

# Local secrets and environment configuration
.env
.env.*
!.env.example

# Node.js dependencies and build outputs
node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
