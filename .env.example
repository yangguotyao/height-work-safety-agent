APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# 前后端同域部署时留空；本地分离开发可填 http://127.0.0.1:5173
CORS_ORIGINS=
AGENT_CONTEXT_MESSAGE_LIMIT=12
AGENT_CONTEXT_CHAR_BUDGET=12000
MCP_ENABLED=true

# 博查 Web Search 仅供通用联网问答使用，不参与安全日志生成和风险计算。
BOCHA_SEARCH_ENABLED=true
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_TIMEOUT_SECONDS=12
BOCHA_SEARCH_MAX_RESULTS=5

# 本地验证默认使用保守 mock；接入外部模型时改为 openai。
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=180
# 仅向阿里云百炼 DashScope OpenAI 兼容接口传递。
MODEL_ENABLE_THINKING=true
MODEL_THINKING_BUDGET=1024
MODEL_ROUTING_THINKING_BUDGET=256
MODEL_AUDIT_THINKING_BUDGET=768
MODEL_RESOLUTION_THINKING_BUDGET=512
MODEL_DEEPSEEK_ENABLE_THINKING=false
MODEL_ROUTING_MAX_TOKENS=5000
MODEL_AUDIT_MAX_TOKENS=8000
MODEL_RESOLUTION_MAX_TOKENS=5000

# Onsite image + text hazard candidate analysis (Alibaba Cloud Model Studio)
HAZARD_VISION_API_KEY=
HAZARD_VISION_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
HAZARD_VISION_MODEL=qwen3.7-plus
HAZARD_VISION_TIMEOUT_SECONDS=180
HAZARD_IMAGE_MAX_MB=10

EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSION=384
AUDIT_CONCURRENCY=4
MAX_UPLOAD_MB=30

# 默认项目名称；运行后可在网页中建立和切换独立项目工作空间。
PROJECT_NAME=XX综合医院扩建项目
PROJECT_LONGITUDE=
PROJECT_LATITUDE=
ACCIDENT_GRAPH_PATH=data/高处作业事故知识图谱_55例/高处作业事故知识图谱.sqlite

# 彩云天气 v2.6。可二选一：填写 Token；或同时填写 App Key 与 App Secret。
CAIYUN_WEATHER_TOKEN=
CAIYUN_APP_KEY=
CAIYUN_APP_SECRET=
WEATHER_TIMEOUT_SECONDS=10
ENFORCE_AUTH=true
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=admin
AUTH_BOOTSTRAP_DISPLAY_NAME=Admin
